<?xml version="1.0"?>
<ruleset
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    name="PHP_CodeSniffer"
    xsi:noNamespaceSchemaLocation="./vendor/squizlabs/php_codesniffer/phpcs.xsd"
    >
    <description>The Omega coding standard. PSR12 + Types</description>
    <arg name="cache" value="cache/phpcs/phpcs.json" />
    <arg name="colors" />
    <arg value="p" />

    <!-- Scope: only the directories that actually hold classes. bootstrap/,
         cache/, config/, routes/, resources/ and storage/ hold arrays, caches,
         plain routes, templates and logs, which phpcs is not meant to read.
         Mirrors the paths in phpstan.neon.dist. -->
    <file>app</file>
    <file>tests</file>

    <rule ref="PSR12">
        <exclude name="PSR1.Methods.CamelCapsMethodName.NotCamelCaps" />
        <exclude name="PSR12.Files.FileHeader.IncorrectGrouping" />
    </rule>
    <!-- Pest test files deliberately mix file-level helpers with it()/dataset()
         side effects: the PHPUnit-private-method flow has no class equivalent,
         so declarations and side effects coexist. -->
    <rule ref="PSR1.Files.SideEffects">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>
    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="lineLimit" value="120"/>
            <property name="absoluteLineLimit" value="0"/>
            <property name="ignoreComments" value="false"/>
        </properties>
    </rule>
</ruleset>
