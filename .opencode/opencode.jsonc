{
  "$schema": "https://opencode.ai/config.json",
  "formatter": true,
  "permissions": [
    { "action": "shell", "resource": "composer*", "effect": "deny" },
    { "action": "shell", "resource": "git*", "effect": "ask" },
    { "action": "shell", "resource": "phpcs*", "effect": "ask" },
    { "action": "shell", "resource": "phpstan*", "effect": "ask" },
    { "action": "shell", "resource": "phpunit*", "effect": "ask" },
    { "action": "shell", "resource": "pest*", "effect": "ask" },
    { "action": "shell", "resource": "phpunit --coverage*", "effect": "deny" },
    { "action": "shell", "resource": "pest --coverage*", "effect": "deny" },
    { "action": "shell", "resource": "pest --type-coverage*", "effect": "ask" }
  ]
}
